      "name": "Debian 13 GNOME Desktop",
      "description": "Debian 13 with the GNOME desktop, reachable over RDP (xrdp). The first boot installs the desktop (about 10 minutes).",
      "version": "1",
      "family": "linux",
      "icon": "debian",
