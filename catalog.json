      ],
      "images": {
        "docker-qemu": {
          "url": "docker://qemux/qemu:latest",
          "format": "container"
        },
        "libvirt": {
          "url": "https://cloud.debian.org/images/cloud/trixie/latest/debian-13-generic-amd64.qcow2",
          "format": "qcow2"
        }
      },
      "params": {
        "cloudinit.packages": "gnome-core firefox-esr xrdp",
        "cloudinit.script": "set -eux\nU=$(id -nu 1000)\n# Desktop session for RDP logins (X11; xrdp has no Wayland support).\ncat > /home/$U/.xsession <<'X'\nexport XDG_CURRENT_DESKTOP=GNOME\nexport XDG_SESSION_TYPE=x11\nexec gnome-session\nX\nchown $U: /home/$U/.xsession\ncp /home/$U/.xsession /etc/skel/.xsession\nadduser xrdp ssl-cert\n# No password prompts for colour profiles / repo refresh inside RDP sessions.\nmkdir -p /etc/polkit-1/rules.d\ncat > /etc/polkit-1/rules.d/45-tossbox-desktop.rules <<'X'\npolkit.addRule(function(action, subject) {\n  if (action.id.indexOf(\"org.freedesktop.color-manager.\") === 0 ||\n      action.id === \"org.freedesktop.packagekit.system-sources-refresh\") {\n    return polkit.Result.YES;\n  }\n});\nX\nsystemctl enable xrdp\nsystemctl restart xrdp\n",
        "docker_qemu.boot_image": "https://cloud.debian.org/images/cloud/trixie/latest/debian-13-generic-amd64.qcow2",
        "os_variant": "debian13"
      }
